{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OldRAGBridgeSchema",
  "description": "Contract for pywebview window.pywebview.api and IIFE bridge.js client",
  "type": "object",
  "definitions": {
    "SearchRequest": {
      "type": "object",
      "required": ["query_text"],
      "properties": {
        "query_text": { "type": "string" },
        "top_k": { "type": "integer", "default": 50 },
        "folder": { "type": ["string", "null"] },
        "sender": { "type": ["string", "null"] },
        "as_of_date_utc": { "type": ["string", "null"] },
        "source_type": { "type": ["string", "null"], "enum": ["EMAIL", "FILE", null] }
      }
    },
    "SearchResultItem": {
      "type": "object",
      "required": ["chunk_id", "doc_id", "content", "source_type", "rrf_score", "normalized_rrf", "relevance_tier"],
      "properties": {
        "chunk_id": { "type": "string" },
        "doc_id": { "type": "string" },
        "content": { "type": "string" },
        "source_type": { "type": "string", "enum": ["EMAIL", "FILE"] },
        "sender": { "type": ["string", "null"] },
        "folder": { "type": ["string", "null"] },
        "received_ts_utc": { "type": ["string", "null"] },
        "original_path": { "type": ["string", "null"] },
        "has_archived_msg": { "type": "boolean" },
        "lexical_rank": { "type": ["integer", "null"] },
        "vector_rank": { "type": ["integer", "null"] },
        "rrf_score": { "type": "number" },
        "normalized_rrf": { "type": "number" },
        "relevance_tier": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] }
      }
    },
    "StatusResponse": {
      "type": "object",
      "required": ["daemon_running", "vlm_active", "items_indexed", "pending_outbox_count", "classic_outlook_active"],
      "properties": {
        "daemon_running": { "type": "boolean" },
        "vlm_active": { "type": "boolean" },
        "items_indexed": { "type": "integer" },
        "pending_outbox_count": { "type": "integer" },
        "classic_outlook_active": { "type": "boolean" },
        "sync_progress_pct": { "type": "number" }
      }
    },
    "OpenCachedMsgRequest": {
      "type": "object",
      "required": ["doc_id"],
      "properties": {
        "doc_id": { "type": "string" }
      }
    },
    "OpenCachedMsgResponse": {
      "type": "object",
      "required": ["success"],
      "properties": {
        "success": { "type": "boolean" },
        "temp_view_path": { "type": ["string", "null"] },
        "error": { "type": ["string", "null"] }
      }
    }
  }
}
